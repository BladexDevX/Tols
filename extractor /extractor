local logQueue = {}
local isProcessingQueue = false

local function processQueue()
    if isProcessingQueue then return end
    isProcessingQueue = true
    task.spawn(function()
        while #logQueue > 0 do
            local data = table.remove(logQueue, 1)
            local cleanText = data.text:gsub("^%-%-%s*", ""):gsub("^%-%-", "")
            drawLine(cleanText, data.color, data.level, data.icon)
            task.wait(0.08)
        end
        isProcessingQueue = false
    end)
end

local function addLine(text, color, level, iconName, instant)
    table.insert(logQueue, {text=text, color=color, level=level, icon=iconName})
    if instant then
        local data = table.remove(logQueue)
        if data then drawLine(data.text, data.color, data.level, data.icon) end
    end
    processQueue()
end

