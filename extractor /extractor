local cacheHits, cacheMisses = 0, 0

local function cachePath(cat, url)
    local filename = cat
    if cat == "cfg" then filename = "config" end
    return CONFIG_DIR .. "/" .. filename .. ".lua"
end

local function cacheGet(cat, url)
    if not CACHE.enabled or CACHE[cat] == false then return nil end
    local p = cachePath(cat, url)
    if isfile and isfile(p) and readfile then
        local ok, c = pcall(readfile, p)
        if ok and type(c) == "string" and #c > 0 then return c end
    end
    return nil
end

local function cacheSet(cat, url, content)
    if not CACHE.enabled or CACHE[cat] == false then return end
    if content:sub(1, 50):lower():find("<!doctype") or content:sub(1, 50):lower():find("<html") then return end
    if writefile then
        local p = cachePath(cat, url)
        pcall(writefile, p, content)
    end
end

local function getRequest()
    return (syn and syn.request) or (http and http.request) or http_request or request
end

local function safeHttpGet(url)
    getgenv().isInternalFetch = true
    local ok, res = pcall(function() return game:HttpGet(url) end)
    getgenv().isInternalFetch = false
    
    if ok and type(res) == "string" and #res > 0 then
        if not res:sub(1, 50):lower():find("<!doctype") and not res:sub(1, 50):lower():find("<html") then
            return res
        end
    end
    local req = getRequest()
    if req then
        getgenv().isInternalFetch = true
        local reqOk, reqRes = pcall(req, {
            Url = url,
            Method = "GET",
            Headers = { ["User-Agent"] = "Roblox/WinInet" }
        })
        getgenv().isInternalFetch = false
        
        if reqOk and type(reqRes) == "table" and tonumber(reqRes.StatusCode) == 200 and reqRes.Body then
            return reqRes.Body
        end
    end
    return nil, "HTTP Fetch Failed"
end

local function cacheHttpGet(url, cat)
    if not CACHE.enabled or CACHE[cat] == false then
        return safeHttpGet(url)
    end

    local c = cacheGet(cat, url)
    local req = getRequest()

    if c and req then
        getgenv().isInternalFetch = true
        local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" } })
        getgenv().isInternalFetch = false
    end

    local r, err = safeHttpGet(url)
    if r then
        cacheMisses = cacheMisses + 1
        cacheSet(cat, url, r)
        return r, false
    end
    return nil, false, err
end

local function fetch(url, cat) return (cacheHttpGet(url, cat or "default")) end
local function fetchTable(url, cat)
    local code = fetch(url, cat); if not code then return nil end
    local fn = loadstring(code); if not fn then return nil end
    local ok, res = pcall(fn)
    if ok and type(res) == "table" then return res end
    return nil
end
local function fetchFunc(url, cat)
    local code = fetch(url, cat); if not code then return nil end
    return loadstring(code)
end

local function prewarmCaches()
    if not CACHE.enabled then return function() end end
    local jobs = {
        {URL_SECURITY_GUARD,      "sec_guard"},
        {URL_LOG_HANDLER,         "logger"},
        {URL_LOADER_ICON,         "icon_loader"},
        {URL_THEME_DARK,          "theme"},
        {URL_EXTRACTOR_LUAMOR,    "luamor_extractor"},
        {URL_EXTRACTOR_SQUAREWEB, "squarweb_extractor"},
        {URL_EXTRACTOR_GENERIC,   "generic_extractor"},
    }
    local remaining, done = 0, false
    for _, j in ipairs(jobs) do
        if CACHE[j[2]] ~= false then
            remaining = remaining + 1
            task.spawn(function()
                pcall(cacheHttpGet, j[1], j[2])
                remaining = remaining - 1
                if remaining <= 0 then done = true end
            end)
        end
    end
    if remaining == 0 then done = true end
    return function()
        local timeout = os.clock() + 5
        while not done and os.clock() < timeout do task.wait(0.02) end
    end
end

