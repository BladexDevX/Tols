local function extractURL(input)
    if type(input) ~= "string" then return nil end
    input = input:match("^%s*(.-)%s*$")
    if input == "" then return nil end
    local u = input:match("^(https?://%S+)$"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*%[=*%[([^%]]+)%]=*%]"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et[Aa]sync%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Uu]rl%s*=%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("(https?://[^%s\"'%)%]]+)"); if u then return u end
    return nil
end

local function silentCleanup()
    pcall(function()
        local targets = {"ImageCache", "cache", "keys"}
        local dirsToCheck = {"", "./"}
        for _, dir in ipairs(dirsToCheck) do
            for _, target in ipairs(targets) do
                local path = dir ~= "" and (dir .. "/" .. target) or target
                if isfolder and isfolder(path) then pcall(delfolder, path) end
                if isfile and isfile(path) then pcall(delfile, path) end
            end
        end
        if listfiles then
            local ok, files = pcall(listfiles, ".")
            if ok and type(files) == "table" then
                for _, file in ipairs(files) do
                    local lower = string.lower(tostring(file))
                    if lower:find("static_content_") or lower:find("imagecache") then
                        pcall(delfolder, file)
                        pcall(delfile, file)
                    end
                end
            end
        end
    end)
end

