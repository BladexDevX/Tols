        setUIState(true)
        
        local success, err = pcall(function()
            local code = fetch(urlFetch, extractorName)
            if not code then error("Error de descarga") end
            
            local fn = loadstring(code)
            if not fn then error("Error de compilacion") end
            
            local ok, execFn = pcall(fn)
            if not ok or type(execFn) ~= "function" then error("Error de estructura") end
            
            local oldPrint = print
            getgenv().print = function(...)
                local msg = table.concat({...}, " ")
                local level, iconName, colorType = "info", "info", "sys"
                
                if LogHandler then
                    local hOk, hLevel, hIcon, hColor = pcall(LogHandler, msg)
                    if hOk then level, iconName, colorType = hLevel, hIcon, hColor end
                else
                    if msg:find("guardado") or msg:find("completado") or msg:find("finalizado") or msg:find("extraído") then
                        level, iconName, colorType = "ok", "check", "ok"
                    elseif msg:find("error") or msg:find("fallo") then
                        level, iconName, colorType = "err", "x", "err"
                    end
                end
                
                local color = C.CON_SYS
                if colorType == "ok" then color = C.CON_OK
                elseif colorType == "err" then color = C.CON_ERR
                elseif colorType == "warn" then color = C.CON_WARN or Color3.new(1, 0.6, 0)
                end
                
                addLine(msg, color, level, iconName)
                oldPrint(...)
            end
            
            pcall(execFn, input)
            getgenv().print = oldPrint
        end)
        
        if not success then addLine(tostring(err), C.CON_ERR, "err", ICO.error) end
        
        local startT = os.clock()
        while (#logQueue > 0 or isProcessingQueue) and (os.clock() - startT < 3) do task.wait(0.1) end
        
        logQueue = {}
        isProcessingQueue = false
        
        local savedDir = EXTRACT_DIR .. "/" .. parsedHost
        local isEmpty = true
        if listfiles then
            local okL, files = pcall(listfiles, savedDir)
            if okL and type(files) == "table" then
                if #files > 0 then isEmpty = false end
            else
                isEmpty = false
            end
        else
            isEmpty = false
        end
        
        if isEmpty then
            addLine("Error: No se pudo extraer código de esta URL -> " .. url, C.CON_ERR, "err", ICO.error)
            pcall(delfolder, savedDir)
        else
            addLine("Guardado en: " .. savedDir, C.CON_SYS, "info", ICO.info)
            addLine("Proceso finalizado", C.CON_OK, "ok", ICO.check)
        end
        
        silentCleanup()
        setUIState(false)
    end)
end

local isFirstRun = true

local function exec(input)
    if execRunning then return end
    if not input or input:match("^%s*$") then addLine("Error: sin URL.", C.CON_ERR, "err", ICO.error, true); return end
    
    if isFirstRun then
        clearConsole()
        isFirstRun = false
    else
        addLine(" ", C.CON_TXT, "info", nil, true) 
    end

    table.insert(history, 1, input)
    if #history > 60 then table.remove(history) end
    histIdx = 0

    local url = extractURL(input)
    if not url then addLine("Error: URL no válido.", C.CON_ERR, "err", ICO.error, true); return end

    for _, intUrl in ipairs(INTERNAL_URLS) do
        if url == intUrl then
            addLine("Error: Esta es una URL interna del sistema. No se puede extraer.", C.CON_ERR, "err", ICO.error, true)
            return
        end
    end

    cacheHits, cacheMisses = 0, 0
    execCancelled = false

    local lowerUrl = url:lower()
    local parsedHost = url and (url:match("^%a+://([^/%?#:]+)") or "extract") or "extract"
    parsedHost = parsedHost:lower()

    if lowerUrl:find("squareweb", 1, true) or lowerUrl:find("v3ntauth", 1, true) or lowerUrl:find("webproxy", 1, true) then
        addLine("SquareWeb detectado", C.CON_SYS, "info", ICO.info)
        runExtractor("squarweb_extractor", URL_EXTRACTOR_SQUAREWEB, input, parsedHost, url)
    elseif lowerUrl:find("luamor", 1, true) or lowerUrl:find("superflow", 1, true) then
        addLine("Luamor detectado", C.CON_SYS, "info", ICO.info)
        runExtractor("luamor_extractor", URL_EXTRACTOR_LUAMOR, input, parsedHost, url)
    elseif lowerUrl:find("goofyscator", 1, true) or lowerUrl:find("railway.app", 1, true) then
        addLine("Goofyscator detectado. Usando generic...", C.CON_SYS, "info", ICO.info)
        runExtractor("generic_extractor", URL_EXTRACTOR_GENERIC, input, parsedHost, url)
    else
        addLine("Dominio desconocido. Usando generic...", C.CON_SYS, "info", ICO.info)
        runExtractor("generic_extractor", URL_EXTRACTOR_GENERIC, input, parsedHost, url)
    end
end

