--show (Lógica de ocultar y mostrar)
local CLOSED = false

local function showWindow()
    RESTORE_BTN.Visible = false; CON_SCR.Visible = false; WIN.Visible = true; WIN_SCALE.Scale = 0.9; isOpen = true
    local target2 = savedScroll
    if target2 then lockScroll = true end
    if target2 and CON_SCR.Parent then
        local maxY = math.max(0, CON_SCR.AbsoluteCanvasSize.Y - CON_SCR.AbsoluteWindowSize.Y)
        CON_SCR.CanvasPosition = Vector2.new(target2.X, math.min(target2.Y, maxY))
    end
    TW(WIN_SCALE, TI_POP, {Scale=1})
    task.spawn(function()
        for _ = 1, 3 do RunService.Heartbeat:Wait() end
        if not isOpen then lockScroll = false; return end
        if target2 and CON_SCR.Parent then
            local maxY = math.max(0, CON_SCR.AbsoluteCanvasSize.Y - CON_SCR.AbsoluteWindowSize.Y)
            CON_SCR.CanvasPosition = Vector2.new(target2.X, math.min(target2.Y, maxY))
        end
        if CON_SCR.Parent then CON_SCR.Visible = true end
        lockScroll = false; savedScroll = nil
    end)
end

local function hideWindow()
    killScroll(); CON_SCR.Visible = false
    if CON_SCR.Parent then savedScroll = CON_SCR.CanvasPosition end
    isOpen = false
    local t = TWc(WIN_SCALE, TI_FAST, {Scale=0.9})
    t.Completed:Connect(function()
        if WIN and WIN.Parent and not CLOSED then WIN.Visible = false; WIN_SCALE.Scale = 1; RESTORE_BTN.Visible = true end
    end)
end

local function shutdown()
    if CLOSED then return end
    CLOSED = true
    execCancelled = true
    dragging = false; resizing = false; activeHandle = nil
    dragStart, winStart = nil, nil; resizeStart, resizeWinPos, resizeWinSize = nil, nil, nil; savedScroll = nil
    pcall(killScroll)
    for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
    connections = {}
    pcall(function()
        if loaderThread and coroutine.status(loaderThread) ~= "dead" then
            task.cancel(loaderThread)
        end
    end)
    pcall(function()
        local g = getgenv()
        if g and g.hooklog then g.hooklog = nil end
    end)
    pcall(cleanFiles)
    pcall(function() if GUI and GUI.Parent then GUI:Destroy() end end)
end

-- Botones de acción
CLOSE_BTN.MouseButton1Click:Connect(function()
    killScroll(); CON_SCR.Visible = false
    local t = TWc(WIN_SCALE, TI_FAST, {Scale=0.85})
    t.Completed:Connect(shutdown)
end)

MINI_BTN.MouseButton1Click:Connect(function() if CLOSED then return end; hideWindow() end)
RESTORE_BTN.MouseButton1Click:Connect(function() if CLOSED then return end; showWindow() end)
