local EXTRACT_DIR = getgenv().EXTRACT_DIR or "Bladex/extract"

local function safeHttpGet(url)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local reqOk, reqRes = pcall(req, {
            Url = url,
            Method = "GET",
            Headers = { 
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            }
        })
        if reqOk and type(reqRes) == "table" and reqRes.StatusCode == 200 and reqRes.Body then 
            local body = reqRes.Body
            if type(body) == "string" and #body > 0 then
                local lowerHead = body:sub(1, 100):lower()
                if not lowerHead:find("<!doctype") and not lowerHead:find("<html") then
                    return body 
                end
            end
        end
    end

    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then
        local lowerHead = res:sub(1, 100):lower()
        if not lowerHead:find("<!doctype") and not lowerHead:find("<html") then
            return res 
        end
    end
    return nil, "HTTP Fetch Failed"
end

local function extractURL(input)
    if type(input) ~= "string" then return nil end
    input = input:match("^%s*(.-)%s*$")
    if input == "" then return nil end
    local u = input:match("^(https?://%S+)$"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et%s*%(?%s*%[=*%[([^%]]+)%]=*%]"); if u then return u end
    u = input:match("[Hh]ttp[Gg]et[Aa]sync%s*%(?%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("[Uu]rl%s*=%s*[\"']([^\"']+)[\"']"); if u then return u end
    u = input:match("(https?://[^%s\"'%)%]]+)"); if u then return u end
    return nil
end

local function formatSize(bytes)
    if bytes >= 1024 * 1024 then
        return string.format("%.2f MB", bytes / (1024 * 1024))
    elseif bytes >= 1024 then
        return string.format("%.2f KB", bytes / 1024)
    else
        return bytes .. " B"
    end
end

local function execSquareWeb(input)
    task.spawn(function()
        local url = extractURL(input)
        if not url then 
            print("-- Error: URL invalido")
            return 
        end

        print("-- SquareWeb V3nt detectado. Iniciando extraccion...")
        local parsedHost = url:match("^%a+://([^/%?#:]+)") or "desconocido"
        local DIR = EXTRACT_DIR .. "/" .. parsedHost:lower()
        pcall(makefolder, DIR)

        local oldLoadstring = loadstring
        local captured = false

        local function myLoadstring(code, chunkname)
            if type(code) == "string" then
                if #code > 500 and not code:find("local KA%s*=%s*{") and not code:find("V3nt v3") then
                    local outPath = DIR .. "/V3nt_FINAL.lua"
                    if writefile then 
                        pcall(writefile, outPath, code) 
                        print("-- ¡CÓDIGO FINAL EXTRAÍDO! | " .. formatSize(#code))
                        captured = true
                    end
                    return function() end
                end
            end
            return oldLoadstring(code, chunkname)
        end

        local safeHook = myLoadstring
        if newcclosure then
            safeHook = newcclosure(myLoadstring)
        end

        if hookfunction then
            pcall(hookfunction, loadstring, safeHook)
            if getgenv().loadstring then
                pcall(hookfunction, getgenv().loadstring, safeHook)
            end
        else
            getgenv().loadstring = safeHook
        end

        local dummyRestore = function(f) return f end
        if hookfunction then
            if restorefunction then pcall(hookfunction, restorefunction, dummyRestore) end
            if restoreclosure then pcall(hookfunction, restoreclosure, dummyRestore) end
            if restorefunc then pcall(hookfunction, restorefunc, dummyRestore) end
        else
            getgenv().restorefunction = dummyRestore
            getgenv().restoreclosure = dummyRestore
            getgenv().restorefunc = dummyRestore
        end

        local src = safeHttpGet(url)
        if src then
            print("-- Ejecutando loader principal...")
            local fn = oldLoadstring(src)
            if fn then pcall(fn) end
        else
            print("-- Error al descargar loader inicial")
        end

        task.wait(2)
        
        if hookfunction then
            pcall(hookfunction, loadstring, oldLoadstring)
        else
            getgenv().loadstring = oldLoadstring
        end

        if not captured then
            print("-- Error: No se pudo capturar el código final.")
        end
    end)
end

return execSquareWeb
