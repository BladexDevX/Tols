local B64 = {}
do
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, #alphabet do B64[s_byte(alphabet, i)] = i - 1 end
    B64[45] = 62
    B64[95] = 63
end

local function b64decode(s)
    local out, buf, bits = {}, 0, 0
    for i = 1, #s do
        local v = B64[s_byte(s, i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local p = 2 ^ bits
                out[#out + 1] = s_char(m_floor(buf / p) % 256)
                buf = buf % p
            end
        end
    end
    return t_concat(out)
end

local function hexdecode(s)
    return (s_gsub(s, "%x%x", function(h) return s_char(tonumber(h, 16)) end))
end

local function percentDecode(s)
    for _ = 1, 4 do
        local n = s_gsub(s, "%%(%x%x)", function(h) return s_char(tonumber(h, 16)) end)
        if n == s then break end
        s = n
    end
    return s
end

local function unescapeJson(s)
    return (s_gsub(s, "\\u(%x%x%x%x)", function(h)
        local n = tonumber(h, 16)
        if n < 128 then return s_char(n) end
    end))
end

local function luaNormalize(s)
    s = s_gsub(s, "[Cc]har%s*%(([%d%s,]+)%)", function(args)
        local t = {}
        for n in s_gmatch(args, "%d+") do
            local v = tonumber(n)
            if v and v < 256 then t[#t + 1] = s_char(v) else return nil end
        end
        return '"' .. t_concat(t) .. '"'
    end)
    s = s_gsub(s, "\\(%d%d?%d?)", function(d)
        local n = tonumber(d)
        if n and n < 256 then return s_char(n) end
    end)
    s = s_gsub(s, "\\x(%x%x)", function(h) return s_char(tonumber(h, 16)) end)
    for _ = 1, 3 do
        local n = s_gsub(s, "[\"']%s*%.%.%s*[\"']", "")
        if n == s then break end
        s = n
    end
    return s
end

local function expand(text, budget)
    local out = {}
    if type(text) ~= "string" or text == "" then return out end
    budget = budget or { n = CFG.DecodeBudget }
    local queue, depth, qi = { text }, { 0 }, 1
    while qi <= #queue and #out < 96 do
        local t, d = queue[qi], depth[qi]
        qi = qi + 1
        out[#out + 1] = s_lower(percentDecode(unescapeJson(t)))
        if d <= 1 and budget.n > 0 and (s_find(t, "[\\\"']") or s_find(t, "[Cc]har%s*%(")) then
            out[#out + 1] = s_lower(luaNormalize(t))
        end
        if d < 3 and budget.n > 0 then
            for run in s_gmatch(t, "[%w%+/%-_=]+") do
                if #run >= 16 and #queue < 160 then
                    for o = 0, 3 do
                        if budget.n <= 0 then break end
                        budget.n = budget.n - #run
                        local dec = b64decode(s_sub(run, o + 1))
                        if #dec >= 8 then
                            queue[#queue + 1] = dec
                            depth[#depth + 1] = d + 1
                        end
                    end
                end
            end
            for run in s_gmatch(t, "%x+") do
                if #run >= 24 and #queue < 160 and budget.n > 0 then
                    budget.n = budget.n - #run
                    queue[#queue + 1] = hexdecode(run)
                    depth[#depth + 1] = d + 1
                    queue[#queue + 1] = hexdecode(s_sub(run, 2))
                    depth[#depth + 1] = d + 1
                end
            end
        end
    end
    return out
end

local function hasAny(variants, needles)
    for v = 1, #variants do
        local t = variants[v]
        for n = 1, #needles do
            if s_find(t, needles[n], 1, true) then return true end
        end
    end
    return false
end

local function cleanUrl(u)
    u = s_gsub(u, "[%c%s]", "")
    u = s_gsub(u, "\\", "/")
    return s_lower(u)
end

local function parseUrl(u)
    local rest = u
    if s_match(rest, "^%a[%w+.-]*:/") then
        rest = s_gsub(rest, "^%a[%w+.-]*:/*", "")
    else
        rest = s_gsub(rest, "^/+", "")
    end
    local authority, path = s_match(rest, "^([^/?#]*)(.*)$")
    authority = s_match(authority, "([^@]*)$")
    local port = s_match(authority, ":(%d+)$")
    local host = s_gsub(authority, ":%d*$", "")
    host = s_gsub(host, "%.+$", "")
    path = s_gsub(s_gsub(path, "/%./", "/"), "/+", "/")
    return host, path, port
end

local function hostIn(host, list)
    if list[host] then return host end
    for entry in pairs(list) do
        if #host > #entry and s_sub(host, -(#entry + 1)) == "." .. entry then
            return entry
        end
    end
end

local function isIPHost(host)
    return s_match(host, "^%d+%.%d+%.%d+%.%d+$") ~= nil
        or s_find(host, "0x%x") ~= nil
        or s_match(host, "^%d+$") ~= nil
        or s_sub(host, 1, 1) == "["
end

local function dnsSuspicious(host)
    local n = 0
    for label in s_gmatch(host, "[^%.]+") do
        n = n + 1
        if #label >= 32 or (#label >= 24 and s_match(label, "^%x+$")) then return true end
    end
    return n > 7
end

local function identInUrl(host, path)
    if not (CFG.IdentityGuard and #IDENT > 0) or hostIn(host, ROBLOX_ALL) then return false end
    for i = 1, #IDENT do
        local v = IDENT[i]
        if #v >= 8 and (s_find(host, v, 1, true) or s_find(path, v, 1, true)) then return true end
    end
    for rawseg in s_gmatch(path, "[^/]+") do
        local seg = s_lower(percentDecode(s_match(rawseg, "^[^?#]*")))
        local base = s_match(seg, "^([^%.]+)") or seg
        for i = 1, #IDENT do
            if seg == IDENT[i] or base == IDENT[i] then return true end
        end
    end
    for label in s_gmatch(host, "[^%.]+") do
        for i = 1, #IDENT do
            if label == IDENT[i] then return true end
        end
    end
    return false
end

local function field(t, name)
    local v = t[name]
    if v ~= nil then return v end
    local ln = s_lower(name)
    for k, val in next, t do
        if type(k) == "string" and s_lower(k) == ln then return val end
    end
end

local function headersToString(h)
    if type(h) ~= "table" then return "", false end
    local parts = {}
    for k, v in next, h do
        local tv = type(v)
        if (type(k) ~= "string" and type(k) ~= "number") or (tv ~= "string" and tv ~= "number") then
            return "", true
        end
        parts[#parts + 1] = tostring(k) .. ":" .. tostring(v)
    end
    return t_concat(parts, "\n"), false
end

local function snapshot(t, depth)
    local c = {}
    for k, v in next, t do
        if depth > 0 and type(v) == "table" then v = snapshot(v, depth - 1) end
        c[k] = v
    end
    return c
end

local function ambiguous(t)
    local seen = {}
    for k in next, t do
        if type(k) == "string" then
            local l = s_lower(k)
            if seen[l] then return true end
            seen[l] = true
        end
    end
    return false
end

local taintUntil = 0
local function taint(seconds)
    local t = os_clock() + seconds
    if t > taintUntil then taintUntil = t end
end

local function judge(u, outbound, idHit)
    local host, path, port = parseUrl(u)
    if host == "" then return true, "host-vacio" end
    if hostIn(host, UserBlock) then return true, "bloqueado-usuario" end
    for p in pairs(UserWebhooks) do
        if s_sub(u, 1, #p) == p then return false end
    end
    for i = 1, #ALWAYS_PATHS do
        if s_find(path, ALWAYS_PATHS[i]) then return true, "ruta-peligrosa" end
    end
    if hostIn(host, UserAllow) then return false end
    if s_find(host, "[\128-\255]") or s_find(host, "xn--", 1, true) then return true, "host-unicode" end
    if not s_find(host, ".", 1, true) then return true, "host-sin-dominio" end
    if hostIn(host, HARD_HOSTS) then return true, "host-malicioso" end
    if hostIn(host, ROBLOX_SENSITIVE) then return true, "api-roblox-sensible" end
    if hostIn(host, ROBLOX_ALL) then
        for i = 1, #ROBLOX_SENSITIVE_PATHS do
            if s_find(path, ROBLOX_SENSITIVE_PATHS[i], 1, true) then return true, "api-roblox-sensible" end
        end
    end
    if CFG.BlockIPHosts and isIPHost(host) then return true, "host-ip-directa" end
    local trusted = hostIn(host, TRUSTED_HOSTS)
    if not trusted then
        if CFG.BlockDnsExfil and dnsSuspicious(host) then return true, "dns-exfil" end
        if outbound and port and port ~= "80" and port ~= "443" then return true, "puerto-inusual" end
        if idHit or identInUrl(host, path) then return true, "identidad-saliente" end
    end
    if outbound then
        for i = 1, #OUTBOUND_PATHS do
            if s_find(path, OUTBOUND_PATHS[i], 1, true) then return true, "ruta-peligrosa" end
        end
        if hostIn(host, SUSPECT_HOSTS) then return true, "exfiltracion-sospechosa" end
        if not trusted then
            if CFG.Strict then return true, "estricto-host-no-confiable" end
            if os_clock() < taintUntil then return true, "script-ofuscado-saliente" end
        end
    end
    return false
end

local function evaluate(url, method, body, headers)
    if url == nil then return false end
    if type(url) ~= "string" then return true, "url-invalida" end
    if #url > CFG.MaxUrl then return true, "url-enorme" end
    if method ~= nil and type(method) ~= "string" then return true, "metodo-invalido" end
    if body ~= nil and type(body) ~= "string" then return true, "body-invalido" end
    if headers ~= nil and type(headers) ~= "table" then return true, "headers-invalidos" end

    method = s_upper(method or "GET")
    local outbound = (method ~= "GET" and method ~= "HEAD") or (body ~= nil and body ~= "")

    local raw = cleanUrl(url)
    if body and #body > CFG.MaxBody and not hostIn((parseUrl(raw)), UserAllow) then
        return true, "payload-enorme"
    end

    local hs, badHeaders = headersToString(headers)
    if badHeaders then return true, "headers-invalidos" end

    local budget = { n = CFG.DecodeBudget }
    local vb = expand(body, budget)
    local vh = expand(hs, budget)

    if hasAny(expand(url, budget), SECRET_NEEDLES) or hasAny(vb, SECRET_NEEDLES) or hasAny(vh, SECRET_NEEDLES) then
        return true, "secreto-detectado"
    end

    local idHit = false
    if CFG.IdentityGuard and #IDENT > 0 then
        local q = s_match(percentDecode(url), "[?#](.*)$") or ""
        idHit = hasAny(expand(q, budget), IDENT) or hasAny(vb, IDENT) or hasAny(vh, IDENT)
    end

    local decoded = cleanUrl(percentDecode(url))
    local blocked, reason = judge(raw, outbound, idHit)
    if blocked then return true, reason end
    if decoded ~= raw then
        blocked, reason = judge(decoded, outbound, idHit)
        if blocked then return true, reason end
    end
    return false
end

local function scanPayload(data, checkIdentity)
    if type(data) ~= "string" then return true, "body-invalido" end
    if #data > CFG.MaxBody then return true, "payload-enorme" end
    local v = expand(data)
    if hasAny(v, SECRET_NEEDLES) then return true, "secreto-detectado" end
    if checkIdentity and CFG.IdentityGuard and hasAny(v, IDENT) then
        return true, "identidad-saliente"
    end
    return false
end

local Log = {}
local Stats = { total = 0, reasons = {} }
local lastWarn, lastWarnCount, lastNotify = {}, 0, 0

local function maskUrl(u)
    return (s_gsub(u, "[^/]+", function(seg)
        if #seg >= 24 then return s_sub(seg, 1, 6) .. "..." end
    end))
end

local function emit(source, safe, reason, warnOnly, detail)
    local now = os_clock()
    local key = reason .. "|" .. safe
    if lastWarn[key] and now - lastWarn[key] < 5 then return end
    if lastWarnCount > 500 then
        lastWarn, lastWarnCount = {}, 0
    end
    lastWarn[key] = now
    lastWarnCount = lastWarnCount + 1

    if CFG.Debug then
        warn(s_format("[Bladex Guard] %s (%s) via %s -> %s%s",
            warnOnly and "ADVERTENCIA" or "BLOQUEADO", reason, source, safe,
            detail and (" [" .. detail .. "]") or ""))
    end
    if CFG.Notify and now - lastNotify >= 3 then
        lastNotify = now
        task.defer(function()
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "Bladex Guard",
                    Text = reason,
                    Duration = 3,
                })
            end)
        end)
    end
end

local function record(source, url, method, reason, warnOnly, detail)
    Stats.total = Stats.total + 1
    Stats.reasons[reason] = (Stats.reasons[reason] or 0) + 1

    local su = type(url) == "string" and url or ("<" .. type(url) .. ">")
    local safe = maskUrl(s_match(su, "^[^?]*") or "")
    if #safe > 90 then safe = s_sub(safe, 1, 90) .. "..." end

    Log[#Log + 1] = { t = os_clock(), source = source, method = method, url = safe, reason = reason, detail = detail }
    if #Log > CFG.MaxLog then t_remove(Log, 1) end

    emit(source, safe, reason, warnOnly, detail)
end

local function inspect(source, url, method, body, headers)
    local ok, blocked, reason = pcall(evaluate, url, method, body, headers)
    if not ok then
        blocked, reason = CFG.FailClosed, "error-interno"
    end
    if blocked then record(source, url, method or "GET", reason) end
    return blocked
end

local function inspectOpts(source, snap)
    if ambiguous(snap) then
        record(source, field(snap, "Url"), "REQ", "args-ambiguos")
        return true
    end
    return inspect(source, field(snap, "Url"), field(snap, "Method"), field(snap, "Body"), field(snap, "Headers"))
end

