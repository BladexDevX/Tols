local CHUNK = 262144

local function deepHostile(code)
    local n = #code
    if n > CFG.MaxScan then return false, true end
    local budget = { n = CFG.DecodeBudget }
    local pos = 1
    while pos <= n do
        local chunk = s_sub(code, pos, pos + CHUNK + 511)
        if hasAny(expand(chunk, budget), HOSTILE_NEEDLES) then return true, false end
        pos = pos + CHUNK
    end
    return false, budget.n <= 0
end

local OBF_SIGS = {
    "luraph", "moonsec", "ironbrew", "prometheus", "wearedevs", "luaobfuscator",
    "obfuscated", "this file was protected", "protected using", "psu.dev", "aztup",
}

local function count(s, pat)
    local _, n = s_gsub(s, pat, "")
    return n
end

local function entropy(s)
    local n = #s
    if n == 0 then return 0 end
    local step = n > 16384 and m_floor(n / 16384) or 1
    local c, total = {}, 0
    for i = 1, n, step do
        local b = s_byte(s, i)
        c[b] = (c[b] or 0) + 1
        total = total + 1
    end
    local e = 0
    for _, v in pairs(c) do
        local p = v / total
        e = e - p * (m_log(p) / m_log(2))
    end
    return e
end

local function analyzeObfuscation(code)
    local sample = code
    if #code > 60000 then
        local mid = m_floor(#code / 2)
        sample = s_sub(code, 1, 20000) .. "\n" .. s_sub(code, mid, mid + 19999) .. "\n" .. s_sub(code, -20000)
    end
    local score, why = 0, {}
    local function add(n, r)
        score = score + n
        why[#why + 1] = r
    end
    local lc = s_lower(sample)
    local n = #sample

    for i = 1, #OBF_SIGS do
        if s_find(lc, OBF_SIGS[i], 1, true) then add(4, "firma:" .. OBF_SIGS[i]) break end
    end
    local dec = count(sample, "\\%d%d?%d?")
    if dec >= 60 then add(3, "escapes-decimales") elseif dec >= 20 then add(1, "escapes-decimales") end
    if count(sample, "\\x%x%x") >= 30 then add(2, "escapes-hex") end
    if count(sample, "%f[%w_][IlO_][Il1O0_][Il1O0_][Il1O0_][Il1O0_][Il1O0_]+%f[^%w_]") >= 8 then
        add(3, "nombres-confusos")
    end
    if count(sample, "_0x%x%x%x+") >= 6 then add(3, "nombres-0x") end
    if count(sample, "[Ll]_%d+_%d+") >= 10 then add(2, "locales-generados") end
    if count(lc, "string%.char") + count(lc, "bxor") + count(lc, "bit32") >= 15 then add(2, "string.char/bxor") end
    if count(lc, "select%s*%(%s*[\"']#[\"']") >= 2 then add(1, "vm-select") end
    if s_find(lc, "[sg]etfenv") then add(1, "getfenv/setfenv") end
    if s_find(s_sub(lc, 1, 400), "return%s*%(?%s*function%s*%(%.%.%.%)") then add(2, "envoltorio-vm") end
    if count(sample, "%d+,%d+,%d+,%d+,%d+,%d+,%d+,%d+") >= 15 then add(2, "tablas-numericas") end
    if count(lc, "loadstring") >= 2 then add(1, "loadstring-anidado") end
    for run in s_gmatch(sample, "[%w%+/=]+") do
        if #run >= 400 then add(2, "blob-base64") break end
    end
    if n >= 1000 then
        local e = entropy(sample)
        if e >= 5.7 then add(3, "entropia-alta") elseif e >= 5.3 then add(1, "entropia-media") end
        local ws = count(sample, "%s")
        if ws / n < 0.05 then add(1, "minificado") end
        local lines = count(sample, "\n") + 1
        if n / lines > 500 then add(1, "lineas-largas") end
    end

    local verdict = "limpio"
    if score >= 7 then verdict = "ofuscado" elseif score >= 3 then verdict = "sospechoso" end
    return verdict, score, why
end

local function inspectCode(source, code, blockHostile, blockObf)
    local ok, hostile, incomplete = pcall(deepHostile, code)
    if not ok then hostile, incomplete = false, true end

    local verdict, score, why = "limpio", 0, {}
    if CFG.DetectObfuscation then
        local okA, v, s, w = pcall(analyzeObfuscation, code)
        if okA then verdict, score, why = v, s, w end
    end
    if #code > CFG.MaxScan then
        verdict = verdict == "limpio" and "sospechoso" or verdict
        why[#why + 1] = "codigo-enorme"
    elseif incomplete then
        why[#why + 1] = "analisis-incompleto"
        if verdict == "limpio" then verdict = "sospechoso" end
    end

    local block = false
    if hostile then
        record(source, "codigo", "LOAD", "codigo-sospechoso", not blockHostile)
        taint(CFG.TaintWindow * 2)
        block = blockHostile
    end
    if verdict ~= "limpio" then
        local detail = "score=" .. score .. " " .. t_concat(why, ",")
        record(source, "codigo", "LOAD",
            verdict == "ofuscado" and "script-ofuscado" or "script-sospechoso-ofuscacion",
            not (blockObf and verdict == "ofuscado"), detail)
        if verdict == "ofuscado" or CFG.TaintOnSuspect then taint(CFG.TaintWindow) end
        if blockObf and verdict == "ofuscado" then block = true end
    end
    return block
end

