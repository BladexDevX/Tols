local function pathIsDangerous(p)
    if type(p) ~= "string" then return false end
    local l = s_lower((s_gsub(p, "\\", "/")))
    if s_find("/" .. l .. "/", "/%.%./") then return true end
    if s_find(l, "autoexec", 1, true) then return true end
    local ext = s_match(l, "%.([%w_]+)$")
    return ext ~= nil and DANGEROUS_EXT[ext] == true
end

