}

local function inspectNet(m, a)
    if GET_M[m] then
        if type(a[3]) == "table" then a[3] = snapshot(a[3], 0) end
        return inspect(m, a[1], "GET", nil, a[3]), "text"
    elseif POST_M[m] then
        if type(a[5]) == "table" then a[5] = snapshot(a[5], 0) end
        return inspect(m, a[1], "POST", a[2], a[5]), "text"
    elseif m == "RequestAsync" then
        if type(a[1]) ~= "table" then return false end
        a[1] = snapshot(a[1], 1)
        return inspectOpts(m, a[1]), "table"
    end
    return false
end

local function isNetTarget(self)
    if typeof(self) ~= "Instance" then return false end
    if self == game then return true end
    local cn = self.ClassName
    return cn == "HttpService" or cn == "HttpRbxApiService"
end

