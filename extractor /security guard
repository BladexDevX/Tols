local Baselines = {}

local function watch(parent, key, name, kind)
    Baselines[#Baselines + 1] = { parent = parent, key = key, value = parent[key], name = name, kind = kind or "global" }
end

local function resolve(path)
    local cur, parent, last = genv, nil, nil
    for part in s_gmatch(path, "[^.]+") do
        if type(cur) ~= "table" then return end
        parent, last, cur = cur, part, cur[part]
    end
    return parent, last, cur
end

local function safeSet(parent, key, value)
    if pcall(function() parent[key] = value end) and parent[key] == value then return true end
    if setreadonly then
        local okRO, wasRO = true, true
        if isreadonly then okRO, wasRO = pcall(isreadonly, parent) end
        pcall(setreadonly, parent, false)
        local ok = pcall(function() parent[key] = value end)
        if okRO and wasRO then pcall(setreadonly, parent, true) end
        if ok and parent[key] == value then return true end
    end
    return false
end

local function install(parent, key, fn, make)
    if safeSet(parent, key, mark(newcc(make(fn)))) then return true end
    if hookfn then
        local holder
        local w2 = mark(newcc(make(function(...) return holder(...) end)))
        local ok, res = pcall(hookfn, fn, w2)
        if ok and res then
            holder = res
            hooked[fn] = true
            return true
        end
    end
    warn("[Bladex Guard] no se pudo instalar hook en " .. tostring(key))
    return false
end

local function hookRequest(path)
    local parent, last, fn = resolve(path)
    if type(fn) ~= "function" or hooked[fn] then return end
    hooked[fn] = true
    local old
    local wrapper = mark(newcc(function(opts, ...)
        if type(opts) == "table" then
            local snap = snapshot(opts, 1)
            if inspectOpts(path, snap) then return fakeResponse() end
            return old(snap, ...)
        end
        return old(opts, ...)
    end))
    local done = false
    if hookfn then
        local ok, res = pcall(hookfn, fn, wrapper)
        if ok then
            old = res
            done = true
        end
    end
    if not done then
        old = fn
        if not safeSet(parent, last, wrapper) then
            warn("[Bladex Guard] no se pudo proteger " .. path)
            return
        end
    end
    watch(parent, last, path)
end

