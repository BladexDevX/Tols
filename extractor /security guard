local function wrapSocket(sock, trusted, path)
    if not CFG.WrapWebSocket then return sock end
    local t = type(sock)
    if t ~= "table" and t ~= "userdata" then return sock end
    return setmetatable({}, {
        __index = function(_, k)
            local v = sock[k]
            if type(v) ~= "function" then return v end
            if k == "Send" or k == "send" then
                return function(_, data, ...)
                    local blocked, reason = scanPayload(data, not trusted)
                    if blocked then
                        record(path .. ".Send", "websocket", "WS", reason)
                        return
                    end
                    return v(sock, data, ...)
                end
            end
            return function(_, ...) return v(sock, ...) end
        end,
        __newindex = function(_, k, val) sock[k] = val end,
    })
end

