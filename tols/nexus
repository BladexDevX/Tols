-- estados
local open = false
local busy = false
local openSize = UDim2.new(0, 300, 0, calculatedHeight)
local closedSize = UDim2.new(0, 0, 0, 0)

-- animacion abrir
local function setOpen(state)
    if busy then return end
    if state == open then return end

    busy = true
    open = state
    OpenButton.Text = state and "CLOSE" or "BLADEX TOOLS"

    if state then
        MainFrame.Visible = true
        MainFrame.Size = closedSize
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = openSize })
        tween:Play()
        tween.Completed:Connect(function() busy = false end)
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Size = closedSize })
        tween:Play()
        tween.Completed:Connect(function()
            if not open then MainFrame.Visible = false end
            busy = false
        end)
    end
end

-- click abrir
OpenButton.MouseButton1Click:Connect(function() setOpen(not open) end)

-- hover abrir
OpenButton.MouseEnter:Connect(function()
    TweenService:Create(OpenButton, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(26, 26, 34) }):Play()
